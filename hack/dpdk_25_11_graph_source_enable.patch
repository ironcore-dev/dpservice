+RTE_EXPORT_SYMBOL(rte_graph_source_node_enable)
+int
+rte_graph_source_node_enable(rte_graph_t id, rte_node_t node_id, bool enable)
+{
+	struct graph_node *graph_node;
+	struct graph *graph;
+	int32_t head = 0;
+
+	graph = graph_from_id(id);
+	if (graph == NULL)
+		return -EINVAL;
+
+	STAILQ_FOREACH(graph_node, &graph->node_list, next)
+		if ((graph_node->node->flags & RTE_NODE_SOURCE_F) &&
+		    graph_node->node->id == node_id)
+			break;
+	if (graph_node == NULL)
+		return -EINVAL;
+
+	graph_node->src_disabled = !enable;
+
+	/* Same source slots as graph_src_nodes_offset_populate(), enabled nodes only */
+	STAILQ_FOREACH(graph_node, &graph->node_list, next)
+		if ((graph_node->node->flags & RTE_NODE_SOURCE_F) &&
+		    !graph_node->src_disabled)
+			graph->graph->cir_start[--head] = graph_node->src_off;
+
+	graph->graph->head = head;
+
+	return 0;
+}
+
