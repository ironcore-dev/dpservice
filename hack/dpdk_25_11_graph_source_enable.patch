+/**
+ * Enable or disable a source node of a graph.
+ *
+ * The graph walk skips a disabled source node: its process function is not
+ * called and its stats do not change. All source nodes of a new graph are
+ * enabled. Only for the RTC model.
+ *
+ * Must not run concurrently with rte_graph_walk() of this graph, e.g. call it
+ * from the lcore walking the graph, between two walks.
+ *
+ * @param id
+ *   Graph id.
+ * @param node_id
+ *   Id of a source node of the graph.
+ * @param enable
+ *   true to enable the source node, false to disable it.
+ *
+ * @return
+ *   0 on success, -EINVAL if the graph is unknown or the node is not a source
+ *   node of it.
+ */
+int rte_graph_source_node_enable(rte_graph_t id, rte_node_t node_id, bool enable);
